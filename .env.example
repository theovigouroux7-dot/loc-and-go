# Base de données en ligne (Supabase). Sans ces deux variables, l'application garde ses données dans le navigateur.
# Supabase > Project Settings > API (ou Data API) : « Project URL » et clé « anon » / « publishable ».
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
