# Base en ligne (Supabase). Sans ces variables, les données restent dans le navigateur (démonstration locale).
NEXT_PUBLIC_SUPABASE_URL=
# Clé « service_role » (ou « secret ») : utilisée uniquement par le serveur, jamais envoyée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe de la page /admin.
ADMIN_PASSWORD=

# Analyse des contrats et des fichiers Excel par Claude (version complète).
ANTHROPIC_API_KEY=
# Modèle utilisé (facultatif).
# ANTHROPIC_MODEL=claude-sonnet-5-5
